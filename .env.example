# Supabase → Project Settings → API
# URL: usa la "Project URL" (https://xxx.supabase.co), NO la cadena postgresql://
SUPABASE_URL=https://tu-proyecto.supabase.co
# Key: "service_role" (secreta). Debe empezar con eyJ...
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Admin login (panel /admin)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia_esta_contraseña

# JWT (genera uno aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=un_secreto_largo_y_aleatorio_minimo_32_caracteres

# Servidor
PORT=3000

# Gmail API (recibo de cita por correo)
# Ver README → sección "Configurar Gmail API"
# true = enviar correos | false = no enviar (citas/pedidos igual se guardan)
EMAIL_ENABLED=true
# true = solo se ve la página de inicio; false = sitio completo
SITE_HOME_ONLY=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=tu-correo@gmail.com
GMAIL_REDIRECT_URI=http://127.0.0.1:3333
# Opcional: copia al negocio cuando llega una cita nueva
GMAIL_NOTIFY_TO=

# URL pública de la app (para links en correos — Render: https://tu-app.onrender.com)
APP_URL=http://localhost:3000

# Google Sign-In para clientes (puede ser el mismo Client ID web de Google Cloud)
# Si no se define, se usa GMAIL_CLIENT_ID como respaldo
GOOGLE_CLIENT_ID=

# Iris — secretaria IA del panel admin (elige UNA)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# o Groq (gratis): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# o Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
